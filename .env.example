# Separate values for staging and production. Never commit real secrets.
NODE_ENV=development
PORT=3000
EXECUTION_MODE=PAPER
AUTO_START_TRADING=false
AUTOSTART_TRADING=false
CONFIRM_LIVE_TRADING=false

# JWT_SECRET must be a securely generated value of at least 32 characters.
JWT_SECRET=
OPERATOR_SECRET=
ADMIN_EMAILS=
# Persistent volume outside dist/build; migrate existing users.db explicitly.
AUTH_DB_PATH=data/auth/users.db
FRONTEND_DIST_DIR=dist
# Only set after verifying your ingress proxy topology.
TRUST_PROXY_HOPS=0
APP_URL=
# Empty means same origin. Cloudflare Pages build must set the environment's backend URL.
VITE_API_URL=

STORAGE_BACKEND=d1
D1_API_URL=
D1_API_SECRET=
# Stable non-secret identifier for the exchange account; same on all replicas.
EXCHANGE_ACCOUNT_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

# Optional, explicit read-only Testnet checks.
RUN_TESTNET_CHECKS=false
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

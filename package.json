{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:full": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "data:fetch": "tsx scripts/fetch-historical-data.ts",
    "data:wfo": "tsx scripts/comprehensive-backtest.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:all": "tsx scripts/run-tests.ts",
    "test:parity": "tsx scripts/parity-test.ts",
    "backtest:full": "tsx scripts/comprehensive-backtest.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "evaluate": "tsx scripts/evaluate-strategies.ts",
    "test:http": "tsx src/tests/serverSecurity.test.ts",
    "test:worker": "tsx src/tests/storageWorkerContract.test.ts",
    "test:testnet": "tsx scripts/test-testnet.ts",
    "check": "npm run lint && npm test && npm run build:full"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.1",
    "recharts": "^3.10.1",
    "sqlite3": "^6.0.1",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "react-is": "^19.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
